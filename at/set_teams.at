local m = { version = "1.3.2" }
local config_path
local enabled = false
local forced_home, forced_away = 0, 0
local current_home, current_away = 0, 0
local status = "dang cho PES dat doi"

local function trim(s)
    return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function find_config(ctx)
    local candidates = {
        ".\\at\\set_teams.ini",
        ctx.at_dir and (ctx.at_dir .. "at\\set_teams.ini") or nil,
        ctx.at_dir and (ctx.at_dir .. "\\at\\set_teams.ini") or nil,
    }
    for _, path in ipairs(candidates) do
        if path then
            local file = io.open(path, "r")
            if file then file:close(); return path end
        end
    end
    return ".\\at\\set_teams.ini"
end

local function read_request()
    local file = io.open(config_path, "r")
    if not file then
        enabled = false
        status = "khong tim thay set_teams.ini"
        return
    end
    local values = {}
    for line in file:lines() do
        line = line:gsub("[;#].*$", "")
        local key, value = line:match("^%s*([%w_]+)%s*=%s*(.-)%s*$")
        if key and value then values[key:lower()] = trim(value) end
    end
    file:close()
    enabled = tonumber(values.enabled or "0") == 1
    forced_home = tonumber(values.home or "0") or 0
    forced_away = tonumber(values.away or "0") or 0
end

function m.set_teams(ctx, home, away)
    read_request()
    current_home, current_away = home, away
    if enabled and home == forced_home and away == forced_away then
        status = string.format("THANH CONG: PES da xac nhan %d vs %d", home, away)
    else
        status = string.format("CHUA KHOP: PES xac nhan %d vs %d", home, away)
    end
    log("NHANH2 SET TEAM v1.3.2 VERIFY: " .. status)
end

function m.overlay_on(ctx)
    read_request()
    return string.format(
        "PES ARENA - NHANH 2 SET TEAM v1.3.2 CORE HOOK\n" ..
        "PES xac nhan: %d vs %d\n" ..
        "Muc tieu: %d vs %d\n" ..
        "Trang thai: %s",
        current_home, current_away, forced_home, forced_away, status)
end

function m.init(ctx)
    config_path = find_config(ctx)
    read_request()
    ctx.register("set_teams", m.set_teams)
    ctx.register("overlay_on", m.overlay_on)
    log(string.format(
        "NHANH2 SET TEAM v1.3.2 CORE_HOOK_MODULE_DA_NAP config=%s Home=%d Away=%d enabled=%s",
        config_path, forced_home, forced_away, tostring(enabled)))
end

return m
